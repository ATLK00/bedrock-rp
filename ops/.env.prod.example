# Copy to `ops/.env` and fill in real values. Never commit `.env`.
# This single file drives BOTH `docker-compose.prod.yml` interpolation AND the
# backend container's `env_file`. Hostnames below are the compose service names
# (postgres / redis) — they only resolve inside the compose network.

# --- postgres container bootstrap (used only on first `up`) ---
POSTGRES_USER=bedrock_rp
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=bedrock_rp

# --- backend (consumed directly by src/config/index.ts) ---
# Same shape as backend/.env.example, but pointing at the compose services.
DATABASE_URL=postgres://bedrock_rp:change-me-strong@postgres:5432/bedrock_rp
REDIS_URL=redis://redis:6379

# Shared secret between BDS script (server-net) and this backend. >= 16 chars.
BDS_BRIDGE_SECRET=change-me-bridge-secret

# Admin control API key (external EXE / admin web / AI-automation client).
# >= 16 chars, sent as x-control-api-key on every /control request.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTROL_API_KEY=change-me-control-key

# Discord OAuth2 app credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be a URL Discord is allowed to redirect to. If you put a reverse proxy
# in front of the backend, use the public URL and set TRUST_PROXY accordingly.
DISCORD_REDIRECT_URI=https://rp.example.com/auth/discord/callback

# Signs the session JWT issued after Discord login. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Express `trust proxy`. Leave "false" unless deployed behind a reverse
# proxy/load balancer, then set the hop count (e.g. "1") or a CIDR list — or
# rate limiting keys on the proxy IP instead of the real client's.
TRUST_PROXY=false

# Comma-separated browser origins allowed to call the session API with
# credentials (e.g. "https://rp.example.com"). Empty = no cross-origin access.
CORS_ORIGINS=

# Player presence heartbeat TTL (keep a few seconds above the pack's ~30s).
PRESENCE_TTL_SECONDS=90

# Bridge signature replay protection.
BRIDGE_SIG_DRIFT_SECONDS=300
BRIDGE_NONCE_TTL_SECONDS=600

# Economy anomaly threshold (cents); append-only retention windows (days).
ECONOMY_ANOMALY_THRESHOLD_CENTS=1000000
SECURITY_EVENT_RETENTION_DAYS=90
IDEMPOTENCY_KEY_RETENTION_DAYS=7

# Rate-limit tiers (per-window max, keyed by client IP).
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_BRIDGE_MAX=120
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_CONTROL_MAX=120

# Where logical DB dumps land on disk. MUST be a host-mounted volume (e.g.
# /var/lib/bedrock-rp/backups) so dumps survive a compose down. The backend
# container itself must be able to write here.
BACKUP_DIR=/var/lib/bedrock-rp/backups

# Optional extra guard for wipe-confirm (IRREVERSIBLE). Set this in prod so a
# stolen control key alone cannot wipe the world.
#WIPE_PASSPHRASE=