{
  "format_version": "1.8.0",
  "animations": {
    "animation.car.moving": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": ["-v.body_pitch", 0, "v.body_roll"],
          "position": [0, "q.property('megaverse:body_height') * 16", 0]
        },
        "steering_wheel": {
          "rotation": [0, 0, "-v.steering_angle * 2.0"]
        },
        "steering_front_left": { "rotation": [0, "v.steering_angle", 0] },
        "steering_front_right": { "rotation": [0, "v.steering_angle", 0] },
        "wheel_front_left": { "rotation": ["-v.wheel_rotation", 0, 0], "scale": "q.property('megaverse:burst_fl') ? 0.0 : 1.0" },
        "wheel_front_right": { "rotation": ["-v.wheel_rotation", 0, 0], "scale": "q.property('megaverse:burst_fr') ? 0.0 : 1.0" },
        "wheel_back_left": { "rotation": ["-v.wheel_rotation", 0, 0], "scale": "q.property('megaverse:burst_rl') ? 0.0 : 1.0" },
        "wheel_rear_right": { "rotation": ["-v.wheel_rotation", 0, 0], "scale": "q.property('megaverse:burst_rr') ? 0.0 : 1.0" }
      }
    }
  }
}
