{
  "format_version": "1.8.0",
  "animations": {
    "animation.player.car_suspension": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            "(q.has_property('megaverse:body_height') ? q.property('megaverse:body_height') : 0) * 16",
            0
          ],
          "rotation": [
            "-(q.has_property('megaverse:body_pitch') ? q.property('megaverse:body_pitch') : 0)",
            0,
            "(q.has_property('megaverse:body_roll') ? q.property('megaverse:body_roll') : 0)"
          ]
        }
      }
    }
  }
}