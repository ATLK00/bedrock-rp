{
  "name": "bedrock-rp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend control-plane for BEDROCK-RP: identity, economy, inventory, RBAC, audit log.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
