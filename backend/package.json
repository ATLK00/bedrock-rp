    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.6",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cookie-parser": "^1.4.7"
  }
