# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8080

# Express `trust proxy` setting. Leave "false" for direct/no-proxy
# deployments. If deployed behind a reverse proxy/load balancer, set
# this or rate limiting will key on the proxy's IP, not the real
# client's. Accepts: true/false, a hop count ("1"), or a comma-
# separated IP/CIDR/preset list ("loopback, 10.0.0.0/8").
TRUST_PROXY=false

DATABASE_URL=postgres://bedrock_rp:changeme@localhost:5434/bedrock_rp
REDIS_URL=redis://localhost:6379

# Shared secret between BDS script (server-net) and this backend.
# Sent as a header on every request from the behavior pack; reject if missing/wrong.
BDS_BRIDGE_SECRET=changeme

# Discord OAuth2 app credentials (console.anthropic.com is NOT this -
# use https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Signs the session JWT issued after Discord login. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Player presence: how long a Redis "online" key stays valid without a
# heartbeat. Keep a few seconds above the behavior pack's heartbeat
# interval (~30s) or healthy players drop off "online" prematurely.
PRESENCE_TTL_SECONDS=90

# Bridge signature replay protection. Max |now - x-bds-ts| accepted (a
# stale request is rejected), and how long a seen x-bds-nonce is remembered
# (an exact replay is rejected). Only enforced when the pack sends the
# signature headers; legacy secret-only clients are unaffected.
BRIDGE_SIG_DRIFT_SECONDS=300
BRIDGE_NONCE_TTL_SECONDS=600

# Comma-separated browser origins allowed to call the session API with
# credentials (e.g. "http://localhost:5173,https://rp.example.com"). CORS
# is only negotiated for requests whose Origin is in this list; everything
# else is treated same-origin. Empty (default) = no cross-origin access.
CORS_ORIGINS=

# A single economy credit >= this many cents raises a HIGH security event
# (economy anomaly: duplicated grants, compromised admin, scaling bugs).
# In the dock's base currency (1 unit = 100 cents), 1,000,000 cents =
# 10,000 units. Adjust to the server's realistic money scale.
ECONOMY_ANOMALY_THRESHOLD_CENTS=1000000
